{
    "name": "victormgomes/laravel-modules-plus",
    "version": "1.0.0",
    "description": "Enhancements for the nWidart/laravel-modules package",
    "keywords": [
        "Victor M. Gomes",
        "laravel",
        "modules-plus"
    ],
    "homepage": "https://github.com/victormgomes/laravel-modules-plus",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/victormgomes/laravel-modules-plus/issues",
        "source": "https://github.com/victormgomes/laravel-modules-plus"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/VictorMGomes"
        }
    ],
    "authors": [
        {
            "name": "Victor M. Gomes",
            "email": "info@victormgomes.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "nwidart/laravel-modules": "^13.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "illuminate/database": "^11.0||^12.0||^13.0",
        "illuminate/http": "^11.0||^12.0||^13.0",
        "illuminate/filesystem": "^11.0||^12.0||^13.0",
        "illuminate/console": "^11.0||^12.0||^13.0",
        "illuminate/view": "^11.0||^12.0||^13.0",
        "illuminate/events": "^11.0||^12.0||^13.0",
        "illuminate/auth": "^11.0||^12.0||^13.0",
        "symfony/finder": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Victormgomes\\ModulesPlus\\": "src/",
            "Victormgomes\\ModulesPlus\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Victormgomes\\ModulesPlus\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Victormgomes\\ModulesPlus\\ModulesPlusServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
